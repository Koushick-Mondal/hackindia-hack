{
  "buildCommand": "pip install -r backend/requirements.txt",
  "outputDirectory": ".",
  "env": {
    "GROQ_API_KEY": "@groq_api_key"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
